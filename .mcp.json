{
  "mcpServers": {
    "maximo": {
      "type": "http",
      "url": "${MAXIMO_MCP_URL}",
      "headers": {
        "apikey": "${MAXIMO_API_KEY}"
      }
    },
    "analises": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "--no-sync", "python", "-m", "maximo_agents.agents.mcp_server"]
    }
  }
}
