# Copie este arquivo para .env e preencha os valores.
# O arquivo .env NUNCA deve ser enviado ao GitHub.

# Chave da API da Anthropic (Claude)
ANTHROPIC_API_KEY=

# Cliente piloto
TENANT_ID=itambe

# URL completa do MCP Server do MAS (rota do OpenShift do ambiente de homologação)
MAXIMO_MCP_URL=

# Chave de API do usuário no Maximo
MAXIMO_API_KEY=
