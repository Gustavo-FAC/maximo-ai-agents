# Copie este arquivo para .env e preencha os valores.
# O arquivo .env NUNCA deve ser enviado ao GitHub.

# LLM (gateway LangChain). LLM_PROVIDER: anthropic | ollama
# Exemplos de LLM_MODEL: claude-sonnet-5-5 (anthropic), qwen2.5:7b (ollama)
LLM_PROVIDER=
LLM_MODEL=
# Só para ollama fora de localhost:11434
LLM_BASE_URL=

# Chave da API da Anthropic (Claude), quando LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Cliente piloto
TENANT_ID=itambe

# URL completa do MCP Server do MAS (rota do OpenShift do ambiente de homologação)
MAXIMO_MCP_URL=

# Chave de API do usuário no Maximo
MAXIMO_API_KEY=
